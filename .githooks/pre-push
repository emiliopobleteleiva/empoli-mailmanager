#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  echo "▶ gitleaks: escaneando el historial antes de pushear..."
  gitleaks git --redact --no-banner
else
  echo "⚠ gitleaks no está instalado; se omite el escaneo de secretos." >&2
fi

echo "▶ lint + typecheck + tests + build..."
pnpm run verify
